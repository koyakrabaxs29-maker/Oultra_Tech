rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. DATA AKUN PENGGUNA: Disimpan di Local Storage (Tidak di Cloud Firestore)
    match /users/{userId} {
      allow read, write: if false;
    }

    // 2. DATA TRANSAKSI UANG MASUK (completed_orders / Penjualan Lunas) - DISIMPAN DI FIREBASE
    match /completed_orders/{orderId} {
      allow read: if true;
      allow write: if isValidId(orderId);
    }

    // 3. DATA TRANSAKSI UANG KELUAR (expenses / Pengeluaran Operasional) - DISIMPAN DI FIREBASE
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId);
    }

    // 4. OPERASIONAL KAFE HARIAN (Staf Kasir, Waitress, Barista, Chef & Owner)
    // Menu & Stok Minuman/Makanan
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    // Status Meja 1-30
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isValidId(tableId);
    }

    // Antrean Pesanan Aktif Dapur & Bar (KDS/BDS/Waitress Order)
    match /active_orders/{orderId} {
      allow read: if true;
      allow write: if isValidId(orderId);
    }

    // Stok Bahan Baku
    match /inventory/{inventoryId} {
      allow read: if true;
      allow write: if isValidId(inventoryId);
    }

    // Tes Koneksi
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
